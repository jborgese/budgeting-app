{
  "name": "budgeting-app",
  "version": "1.0.0",
  "description": "A budgeting application built with Electron",
  "main": "public/main.js",
  "scripts": {
    "start": "node server.js",
    "dist": "cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder",
    "update-tax-data": "node scripts/updateTaxData.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "cross-env": "^7.0.3",
    "wrangler": "^3.0.0"
  },
  "dependencies": {
    "@cloudflare/kv-asset-handler": "^0.3.0",
    "electron": "^28.0.0",
    "exceljs": "^4.4.0",
    "express": "^4.17.1"
  },
  "build": {
    "appId": "com.example.exceltoelectron",
    "productName": "Budgeting App",
    "files": [
      "public/**/*",
      "node_modules/**/*"
    ],
    "mac": {
      "icon": "assets/icon.icns",
      "category": "public.app-category.utilities",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "icon": "assets/icon.ico",
      "sign": false,
      "target": [
        "nsis",
        "zip"
      ]
    },
    "directories": {
      "buildResources": "assets",
      "output": "dist"
    },
    "afterSign": "scripts/afterSignHook.js"
  }
}
